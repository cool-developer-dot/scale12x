# Scale12x — environment template
# Copy to .env.local for local overrides. Do not commit secrets.

# Optional public site URL override (defaults to https://scale12x.com in app code)
# NEXT_PUBLIC_SITE_URL=https://scale12x.com

# Optional webhook for Contact form submissions (JSON POST)
# CONTACT_WEBHOOK_URL=https://hooks.example.com/contact

# Optional Calendly override (defaults to https://calendly.com/foreman-pilot/30min)
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/foreman-pilot/30min

# --- Private admin auth (Phase 1) ---
# Obtain URL + publishable key from Supabase → Project Settings → API Keys
# ADMIN_EMAIL is server-only (do not prefix with NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
ADMIN_EMAIL=

# --- Contact lead persistence (Phase 2) ---
# SERVER ONLY — Supabase Dashboard → Project Settings → API Keys → Secret key
# Never expose via NEXT_PUBLIC_. Used by /api/contact to insert into contact_inquiries.
SUPABASE_SECRET_KEY=
